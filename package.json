{
  "name": "market-wire",
  "version": "0.1.0",
  "description": "Market Wire V2 — local shortage matching for traders",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('web', 'dist/web', { recursive: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose --exclude 'test/integration/**' --exclude 'test/property/**' --exclude 'test/mcp/**'",
    "test:property": "npm run build && node --test review/core-regressions.test.mjs",
    "test:pg": "npm run build && node --test review/postgres-race.test.mjs",
    "smoke": "node review/api-smoke.mjs",
    "migrate": "tsx src/infra/db/migrate.ts",
    "dev": "tsx watch src/index.ts",
    "mcp": "node dist/src/mcp/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "10.1.12",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "fastify": "^5.2.1",
    "kysely": "0.28.17",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "fast-check": "^3.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
